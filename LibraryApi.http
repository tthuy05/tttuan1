@LibraryApi_HostAddress = http://localhost:5200

GET {{LibraryApi_HostAddress}}/api/v1/health-check
Accept: application/json

###

GET {{LibraryApi_HostAddress}}/api/v1/books?page=1&pageSize=10&category=IT&sort=title
Accept: application/json

###

GET {{LibraryApi_HostAddress}}/api/v1/books/1
Accept: application/json

###

POST {{LibraryApi_HostAddress}}/api/v1/books
Content-Type: application/json

{
  "title": "ASP.NET Core in Action",
  "author": "Andrew Lock",
  "category": "IT",
  "publishedYear": 2023
}

###

PATCH {{LibraryApi_HostAddress}}/api/v1/books/1
Content-Type: application/json

{
  "category": "Software Engineering"
}

###

DELETE {{LibraryApi_HostAddress}}/api/v1/books/1
